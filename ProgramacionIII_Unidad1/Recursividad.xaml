<Page x:Class="ProgramacionIII_Unidad1.Recursividad"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Recursividad">

    <Page.Resources>

        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="5"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- el de ejecutar -->
        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4F46E5"/>
                            </Trigger>

                            <!-- Click -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Botón (Volver) -->
        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5F5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Page.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- titulo -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Content="Volver" 
                    Width="50" 
                    Height="40" 
                    Margin="0,0,10,0"
                    x:Name="BtnVolver"
                    Style="{StaticResource BotonIcono}" Click="BtnVolver_Click"/>
            <StackPanel>
                <TextBlock Text="Recursividad" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#7C3AED"/>
                <TextBlock Text="Explora funciones recursivas paso a paso" 
                           Foreground="#64748B"/>
            </StackPanel>
        </StackPanel>

        <!-- menu -->
        <Border Grid.Row="1" Grid.Column="0"
        Background="White"
        CornerRadius="12"
        Padding="15"
        Margin="0,20,20,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Funciones Recursivas"
                       FontWeight="Bold"
                       FontSize="14"/>

                    <TextBlock Text="Selecciona un ejercicio"
                       Foreground="Gray"
                       Margin="0,0,0,10"/>

                    <!-- 1 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnCapicua_Click">
                        <TextBlock Text="1. Número Capicúa"/>
                    </Button>

                    <!-- 2 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnSumaVector_Click">
                        <TextBlock Text="2. Sumar Vector"/>
                    </Button>

                    <!-- 3 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnMultiplicarVector_Click">
                        <TextBlock Text="3. Multiplicar Vector"/>
                    </Button>

                    <!-- 4 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnMenor_Click">
                        <TextBlock Text="4. Menor del Vector"/>
                    </Button>

                    <!-- 5 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnMayor_Click">
                        <TextBlock Text="5. Mayor del Vector"/>
                    </Button>

                    <!-- 6 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnFactorial_Click">
                        <TextBlock Text="6. Factorial"/>
                    </Button>

                    <!-- 7 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnFibonacci_Click">
                        <TextBlock Text="7. Fibonacci"/>
                    </Button>

                    <!-- 8 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnInvertir_Click">
                        <TextBlock Text="8. Invertir Número"/>
                    </Button>

                    <!-- 9 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnSumarDigitos_Click">
                        <TextBlock Text="9. Sumar Dígitos"/>
                    </Button>

                    <!-- 10 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnSuma_Click">
                        <TextBlock Text="10. Suma 1 hasta n"/>
                    </Button>

                    <!-- 11 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnParImpar_Click">
                        <TextBlock Text="11. Par o Impar"/>
                    </Button>

                    <!-- 12 -->
                    <Button Style="{StaticResource BotonMenu}" Height="55" Margin="0,5"
                    Click="BtnPositivoNegativo_Click">
                        <TextBlock Text="12. Positivo o Negativo"/>
                    </Button>

                </StackPanel>

            </ScrollViewer>

        </Border>


        <!-- derecha -->
        <Border x:Name="PanelPrincipal"
                Grid.Row="1" Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,20,0,0"
                Visibility="Collapsed">

            <StackPanel>

                <TextBlock x:Name="TituloFuncion"
                           FontSize="18"
                           FontWeight="Bold"/>

                <TextBlock x:Name="DescripcionFuncion"
                           Foreground="Gray"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Valor de n"/>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtValor" Width="350" Height="35" Margin="0,5"/>
                    <Button Content="Ejecutar"
                            Margin="10,0,0,0"
                            Background="#6366F1"
                            Foreground="White"
                            Padding="10,5"
                            BorderThickness="0"
                            Click="BtnEjecutar_Click"
                            Style="{StaticResource BotonPrimario}" Cursor="Hand"/>
                </StackPanel>

                <TextBlock x:Name="TextoInfo"
                           Margin="40,40,0,0"
                           HorizontalAlignment="Center"
                           Foreground="Gray"/>

                <Border Background="#F1F5F9"
                        Padding="10"
                        CornerRadius="8"
                        Margin="0,15,0,0">

                        <TextBlock x:Name="Definicion"
                                   FontFamily="Consolas"/>
                </Border>


            </StackPanel>

        </Border>

    </Grid>
</Page>

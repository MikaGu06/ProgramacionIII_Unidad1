<Page x:Class="ProgramacionIII_Unidad1.EstructurasNoLineales.Grafos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Grafos">

    <Page.Resources>
        <!-- NO PERMITIR QUE SE COMBINEN CARACTERES CON ENTEROS EN UN MISMO ARBOL-->
        <!-- Paleta nueva coherente con tu proyecto -->
        <Color x:Key="BgPage">#F7F5FA</Color>
        <!-- fondo crema/lavanda -->
        <Color x:Key="Primary">#7F73A1</Color>
        <!-- morado principal -->
        <Color x:Key="PrimaryHover">#262233</Color>
        <!-- morado oscuro -->
        <Color x:Key="PrimarySoft">#E8E2F2</Color>
        <!-- lavanda suave -->
        <Color x:Key="TextPrimary">#262233</Color>
        <!-- texto oscuro -->
        <Color x:Key="TextMuted">#726C80</Color>
        <!-- gris -->
        <Color x:Key="CanvasBg">#FFFFFF</Color>
        <!-- fondo canvas -->
        <Color x:Key="BorderSoft">#DDD8E7</Color>
        <!-- bordes suaves -->
        <Color x:Key="Danger">#8A4D67</Color>
        <!-- rojo elegante -->
        <Color x:Key="Warning">#C9A3C8</Color>
        <!-- rosa/lavanda -->

        <SolidColorBrush x:Key="BgPageBrush" Color="{StaticResource BgPage}"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoft}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="CanvasBgBrush" Color="{StaticResource CanvasBg}"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoft}"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FBFCF7"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="28"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#FBFCF7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FBFCF7"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#A94E40"/>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#A87435"/>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FBFCF7"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RegresarInicio"
                            Style="{StaticResource BtnGhost}"
                            Width="42"
                            Margin="0,0,18,0"
                            Click="RegresarInicio_Click">
                        <TextBlock Text="←" FontSize="20"/>
                    </Button>

                    <StackPanel>
                        <TextBlock Text="Grafos"
                                   Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Construye, visualiza y analiza grafos con recorridos BFS, DFS, Dijkstra, lista y matriz de adyacencia."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="14"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Modo actual"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtModoActual"
                                   Text="Dirigido"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Operaciones" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Vertice" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="txtVertice" Style="{StaticResource InputStyle}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Agregar vertice" Click="BtnAgregarVertice_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="Eliminar vertice" Click="BtnEliminarVertice_Click" Style="{StaticResource DangerButton}" Margin="0,0,0,10"/>
                                </WrapPanel>

                                <Separator Margin="0,16,0,16"/>

                                <TextBlock Text="Origen" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="txtOrigen" Style="{StaticResource InputStyle}"/>
                                <TextBlock Text="Destino" Style="{StaticResource LabelText}" Margin="0,12,0,6"/>
                                <TextBox x:Name="txtDestino" Style="{StaticResource InputStyle}"/>
                                <TextBlock Text="Peso" Style="{StaticResource LabelText}" Margin="0,12,0,6"/>
                                <TextBox x:Name="txtPeso" Style="{StaticResource InputStyle}"/>
                                <CheckBox x:Name="chkDirigido" Content="Arista dirigida" Style="{StaticResource CheckStyle}"/>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Agregar arista" Click="BtnAgregarArista_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="+ Lazo" Click="BtnAgregarLazo_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="Eliminar" Click="BtnEliminarArista_Click" Style="{StaticResource DangerButton}" Margin="0,0,0,10"/>
                                </WrapPanel>

                                <TextBlock Text="Nuevo peso" Style="{StaticResource LabelText}" Margin="0,8,0,6"/>
                                <TextBox x:Name="txtNuevoPeso" Style="{StaticResource InputStyle}"/>
                                <Button Content="Modificar peso" Click="BtnModificarPeso_Click" Style="{StaticResource WarningButton}" Margin="0,12,0,0"/>

                                <Separator Margin="0,18,0,18"/>

                                <TextBlock Text="Inicio de recorrido" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="txtInicioRecorrido" Style="{StaticResource InputStyle}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="BFS" Click="BtnBfs_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="DFS" Click="BtnDfs_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="Dijkstra" Click="BtnDijkstra_Click" Style="{StaticResource WarningButton}" Margin="0,0,0,10"/>
                                </WrapPanel>

                                <Separator Margin="0,18,0,18"/>

                                <WrapPanel>
                                    <Button Content="Lista" Click="BtnLista_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="Matriz" Click="BtnMatriz_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="Dir / No Dir" Click="BtnToggleDir_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"/>
                                </WrapPanel>

                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Demo" Click="BtnDemo_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="Reiniciar" Click="BtnLimpiar_Click" Style="{StaticResource DangerButton}" Margin="0,0,0,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Estado" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="txtEstado"
                                           Text="Listo para comenzar."
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Vertices" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="txtTotalVertices" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,14" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Aristas" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="txtTotalAristas" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Resultado" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="txtRecorridoResultado"
                                           Text="Sin ejecutar"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="18,18,18,12">
                                <StackPanel>
                                    <TextBlock Text="Visualizador del grafo" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock Text="Los vertices se distribuyen automaticamente en circulo para una vista clara, con una paleta inspirada en arboles."
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="canvasGrafo"
                                        Width="900"
                                        Height="600"
                                        Background="{StaticResource CanvasBgBrush}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
<UserControl x:Class="ProgramacionIII_Unidad1.EstructurasNoLineales.ArbolBinario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Paleta de colores -->
        <SolidColorBrush x:Key="ColorPrimario" Color="#7F73A1"/>
        <SolidColorBrush x:Key="ColorPrimarioHover" Color="#262233"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#8A4D67"/>
        <SolidColorBrush x:Key="PrimarioSuave" Color="#9B8DBE"/>
        <SolidColorBrush x:Key="FondoLavanda" Color="#E8E2F2"/>
        <SolidColorBrush x:Key="Card" Color="White"/>
        <SolidColorBrush x:Key="InputColor" Color="#F7F5FA"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#DDD8E7"/>
        <SolidColorBrush x:Key="TextoOscuro" Color="#262233"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#726C80"/>
        <SolidColorBrush x:Key="AcentoRosa" Color="#C9A3C8"/>
        <SolidColorBrush x:Key="AcentoVerde" Color="#E1ECE3"/>

        <!-- Estilo de botón primario con animación -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorPrimarioHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.05" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.05" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo de botón de peligro -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource ColorAlerta}"/>
        </Style>

        <!-- Estilo de botón secundario -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource PrimarioSuave}"/>
        </Style>

        <!-- Estilo para TextBox -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para RadioButtons -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="🌳 Árbol Binario"
                       FontSize="24"
                       FontFamily="Segoe UI Semibold"
                       Foreground="{StaticResource TextoOscuro}"/>
            <TextBlock Text="Estructura jerárquica donde cada nodo tiene máximo dos hijos (izquierdo y derecho)"
                       FontSize="13"
                       Foreground="{StaticResource TextoClaro}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- PANEL DE OPERACIONES PRINCIPALES -->
        <Border Grid.Row="1"
                Background="{StaticResource Card}"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📝 Operaciones del árbol"
                           FontSize="14"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtNodeValue" 
                             Grid.Column="0"
                             Style="{StaticResource InputStyle}"
                             Width="140"
                             Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <RadioButton x:Name="rbIntegers" Content="🔢 Enteros" IsChecked="True"/>
                        <RadioButton x:Name="rbCharacters" Content="🔤 Caracteres"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="➕ Añadir (BST)" Click="AddNode_Click" Style="{StaticResource BtnPrimary}"/>
                        <Button Content="❌ Eliminar" Click="Delete_Click" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"/>
                        <Button Content="⚖️ Balancear" Click="Balancear_Click" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"/>
                        <Button Content="🗑️ Limpiar" Click="Limpiar_Click" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- PANEL DE INSERCIÓN MANUAL (SIMPLIFICADO) -->
        <Border Grid.Row="2"
                Background="{StaticResource Card}"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🎯 Inserción Manual"
                           FontSize="14"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Nodo padre:" 
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextoClaro}"
                               Margin="0,0,8,0"/>

                    <TextBox x:Name="txtPadre"
                             Grid.Column="1"
                             Style="{StaticResource InputStyle}"
                             Width="100"
                             Margin="0,0,12,0"
                             ToolTip="Valor del nodo padre"/>

                    <TextBlock Grid.Column="2" Text="Nuevo valor:" 
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextoClaro}"
                               Margin="0,0,8,0"/>

                    <TextBox x:Name="txtNuevoValor"
                             Grid.Column="3"
                             Style="{StaticResource InputStyle}"
                             Width="100"
                             Margin="0,0,12,0"
                             ToolTip="Valor del nuevo nodo"/>

                    <ComboBox x:Name="cbPosicion"
                              Grid.Column="4"
                              Width="100"
                              Height="38"
                              Background="{StaticResource InputColor}"
                              BorderBrush="{StaticResource BordesSuaves}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="⬅️ Izquierda"/>
                        <ComboBoxItem Content="➡️ Derecha"/>
                    </ComboBox>
                </Grid>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button x:Name="BtnInsertarRaiz"
                            Content="🌱 Insertar Raíz"
                            Style="{StaticResource BtnPrimary}"
                            Click="BtnInsertarRaiz_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BtnInsertarManual"
                            Content="➕ Insertar en posición"
                            Style="{StaticResource BtnSecondary}"
                            Click="BtnInsertarManual_Click"
                            Margin="8,0,0,0"/>
                </UniformGrid>

                <Border Background="{StaticResource FondoLavanda}"
                        CornerRadius="8"
                        Padding="8">
                    <TextBlock Text="💡 Ingresa el valor del padre, el nuevo valor y selecciona izquierda o derecha"
                               FontSize="11"
                               Foreground="{StaticResource TextoOscuro}"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- CONTADORES -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource FondoLavanda}"
                    BorderBrush="{StaticResource BordesSuaves}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,6">
                <TextBlock x:Name="TxtNodos"
                           Text="📊 Nodos: 0"
                           Foreground="{StaticResource TextoOscuro}"
                           FontSize="13"
                           FontWeight="Semibold"/>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource AcentoVerde}"
                    BorderBrush="{StaticResource BordesSuaves}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,6"
                    Margin="12,0,0,0">
                <TextBlock x:Name="TxtAltura"
                           Text="📏 Altura: 0"
                           Foreground="{StaticResource TextoOscuro}"
                           FontSize="13"
                           FontWeight="Semibold"/>
            </Border>
        </Grid>

        <!-- ÁREA VISUAL DEL ÁRBOL -->
        <Border Grid.Row="4"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1.5"
                CornerRadius="16"
                Background="{StaticResource Card}"
                Padding="12"
                Margin="0,0,0,16">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          Background="White">
                <Canvas x:Name="canvas" 
                        Background="White" 
                        Width="2000" 
                        Height="1000"
                        MinWidth="800"
                        MinHeight="500"/>
            </ScrollViewer>
        </Border>

        <!-- PANEL DE RECORRIDOS -->
        <Border Grid.Row="5"
                Background="{StaticResource Card}"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🔄 Recorridos del árbol"
                           FontSize="14"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"
                           Margin="0,0,0,12"/>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Button Content="📋 PreOrden" Click="Preorden_Click" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                    <Button Content="📖 InOrden" Click="Inorden_Click" Style="{StaticResource BtnPrimary}" Margin="8,0"/>
                    <Button Content="📚 PostOrden" Click="Postorden_Click" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"/>
                </UniformGrid>

                <Border Background="{StaticResource InputColor}"
                        CornerRadius="12"
                        Padding="12"
                        BorderBrush="{StaticResource BordesSuaves}"
                        BorderThickness="1">
                    <TextBlock x:Name="txtResultado" 
                               Text="✨ Seleccione un recorrido para ver el resultado..."
                               TextAlignment="Center" 
                               Foreground="{StaticResource TextoClaro}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- PANEL DE INFORMACIÓN SIMPLIFICADO -->
        <Border Grid.Row="6"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1.5"
                CornerRadius="16"
                Background="{StaticResource Card}"
                Padding="20">
            <StackPanel>
                <TextBlock Text="ℹ️ Propiedades del árbol"
                           FontSize="15"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"
                           Margin="0,0,0,12"/>

                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <Button x:Name="BtnEsCompleto"
                            Style="{StaticResource BtnSecondary}"
                            Background="#E8E2F2"
                            Margin="0,0,12,0"
                            Click="BtnEsCompleto_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✓ ¿Árbol completo?"
                                       FontSize="13"
                                       FontWeight="Semibold"/>
                            <TextBlock x:Name="TxtEsCompleto"
                                       Text="Verificar"
                                       FontSize="14"
                                       FontWeight="Semibold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnEsPerfecto"
                            Style="{StaticResource BtnSecondary}"
                            Background="#F1E0E7"
                            Click="BtnEsPerfecto_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⭐ ¿Árbol perfecto?"
                                       FontSize="13"
                                       FontWeight="Semibold"/>
                            <TextBlock x:Name="TxtEsPerfecto"
                                       Text="Verificar"
                                       FontSize="14"
                                       FontWeight="Semibold"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Button x:Name="BtnNodoRaiz"
                        Style="{StaticResource BtnSecondary}"
                        Content="🌳 Ver nodo raíz"
                        Click="BtnNodoRaiz_Click"
                        Margin="0,0,0,16"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
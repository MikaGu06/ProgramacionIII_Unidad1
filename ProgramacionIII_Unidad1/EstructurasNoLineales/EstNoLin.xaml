<Page x:Class="ProgramacionIII_Unidad1.EstructurasNoLineales.EstNoLin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProgramacionIII_Unidad1.EstructurasNoLineales"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="EstNoLin">

    <Page.Resources>

        <!-- Paleta nueva -->
        <SolidColorBrush x:Key="ColorPrimario" Color="#7F73A1"/>
        <SolidColorBrush x:Key="PrimarioOscuro" Color="#262233"/>
        <SolidColorBrush x:Key="PrimarioClaro" Color="#E8E2F2"/>
        <SolidColorBrush x:Key="Card" Color="#F7F5FA"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#DDD8E7"/>
        <SolidColorBrush x:Key="TextoOscuro" Color="#262233"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#726C80"/>
        <SolidColorBrush x:Key="InputColor" Color="#F7F5FA"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#8A4D67"/>
        <SolidColorBrush x:Key="AlertaOscuro" Color="#6F3C53"/>

        <!-- Acentos -->
        <SolidColorBrush x:Key="AcentoRosa" Color="#C9A3C8"/>
        <SolidColorBrush x:Key="AcentoVerde" Color="#E1ECE3"/>
        <SolidColorBrush x:Key="AcentoLavandaSuave" Color="#F1EAF7"/>

        <!-- Botón principal -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarioOscuro}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1B2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón transparente -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AcentoLavandaSuave}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F7F5FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SelectedMenuCardStyle" TargetType="Border" BasedOn="{StaticResource MenuCardStyle}">
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
        </Style>

        <Style x:Key="BtnMenuCard" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="Background" Value="#F7F5FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimarioOscuro}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" MinWidth="1180">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RegresarInicio" 
                    Style="{StaticResource BtnGhost}" Width="42" Margin="0,0,18,0" Click="RegresarInicio_Click">
                    <TextBlock Text="←" FontSize="20"/>
                </Button>

                <StackPanel>
                    <TextBlock Text="Estructuras No Lineales"
                           FontSize="42"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource PrimarioOscuro}"/>
                    <TextBlock Text="Visualiza Grafos y Árboles"
                           FontSize="16"
                           Foreground="{StaticResource TextoClaro}"/>
                </StackPanel>
            </StackPanel>

            <!-- Panel izquierdo -->
            <Border Grid.Row="1" Grid.Column="0"
                Background="#F7F5FA"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22"
                Margin="0,24,0,0">

                <StackPanel>
                    <TextBlock Text="Estructuras"
                           FontSize="18"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"/>
                    <TextBlock Text="Selecciona una estructura"
                           Margin="0,6,0,20"
                           FontSize="14"
                           Foreground="{StaticResource TextoClaro}"/>

                    <Button Style="{StaticResource BtnMenuCard}"
                        Content="Grafo Dirigido" x:Name="btnGrafoDirigido" Click="btnGrafoDirigido_Click"/>
                    <Button Style="{StaticResource BtnMenuCard}"
                        Content="Grafo No Dirigido" x:Name="btnGrafoNoDirigido" Click="btnGrafoNoDirigido_Click"/>
                    <Button Style="{StaticResource BtnMenuCard}"
                            Content="Grafo Ponderado" x:Name="btnGrafoPonderado" Click="btnGrafoPonderado_Click"/>

                    <Button Style="{StaticResource BtnMenuCard}"
                        Content="Árboles Bianrios" x:Name="btnArbolbin" Click="btnArbolbin_Click"
                        />
                    

                    

                    
                </StackPanel>
            </Border>

            <!-- Card derecha -->
            <Border Grid.Row="1" Grid.Column="2"
                Background="{StaticResource Card}"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28"
                Margin="0,24,0,0"
                VerticalAlignment="Top">
                <ContentControl x:Name="ContenidoDinamico"/>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>

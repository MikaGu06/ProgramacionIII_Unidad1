<UserControl x:Class="ProgramacionIII_Unidad1.EstructurasNoLineales.ArbolBinario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="920"
             d:DesignWidth="1280"
             Background="#F6F7FB">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BgPage"        Color="#F6F7FB"/>
        <SolidColorBrush x:Key="BgCard"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSoft"        Color="#F1F3FA"/>
        <SolidColorBrush x:Key="Primary"       Color="#5B5BD6"/>
        <SolidColorBrush x:Key="PrimaryHover"  Color="#4848B8"/>
        <SolidColorBrush x:Key="PrimarySoft"   Color="#ECECFF"/>
        <SolidColorBrush x:Key="Danger"        Color="#D94F70"/>
        <SolidColorBrush x:Key="DangerHover"   Color="#BF3C5C"/>
        <SolidColorBrush x:Key="SuccessSoft"   Color="#EAF8EF"/>
        <SolidColorBrush x:Key="WarningSoft"   Color="#FFF4E8"/>
        <SolidColorBrush x:Key="BorderSoft"    Color="#E3E7F0"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#1F2430"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#667085"/>
        <SolidColorBrush x:Key="CanvasBg"      Color="#FCFCFE"/>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#15000000" BlurRadius="18"
                          ShadowDepth="2"  Opacity="0.18"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius"     Value="18"/>
            <Setter Property="Padding"          Value="18"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Effect"           Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily"  Value="Segoe UI Semibold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin"   Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="#FAFBFF"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness"          Value="1.2"/>
            <Setter Property="Foreground"               Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="Padding"                  Value="12,9"/>
            <Setter Property="MinHeight"                Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background"      Value="#FAFBFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="MinHeight"       Value="42"/>
            <Setter Property="Padding"         Value="10,6"/>
        </Style>

        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground"        Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Margin"            Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Background"  Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding"     Value="16,10"/>
            <Setter Property="MinHeight"   Value="42"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontFamily"  Value="Segoe UI Semibold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin"  Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ ENCABEZADO ══ -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Arbol Binario"
                               Style="{StaticResource TitleText}"
                               FontSize="28"/>
                    <TextBlock Text="Construye, visualiza, recorre y analiza el arbol. El canvas se expande automaticamente para mostrar todos los nodos."
                               Style="{StaticResource CaptionText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimarySoft}"
                        CornerRadius="14" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Modo actual"
                                   Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="BST / Manual"
                                   Foreground="{StaticResource Primary}"
                                   FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ CONTENIDO ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── PANEL IZQUIERDO ─── -->
                <StackPanel Grid.Column="0">

                    <!-- Operaciones principales -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Operaciones principales"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Valor" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtNodeValue"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Ingresa un numero entero o un caracter"/>

                            <TextBlock Text="Tipo de dato"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbIntegers"
                                             Content="Enteros"
                                             IsChecked="True"
                                             Style="{StaticResource RadioStyle}"/>
                                <RadioButton x:Name="rbCharacters"
                                             Content="Caracteres"
                                             Style="{StaticResource RadioStyle}"/>
                            </StackPanel>

                            <WrapPanel Margin="0,18,0,0" ItemHeight="42" ItemWidth="160">
                                <Button Content="Añadir (BST)"
                                        Click="AddNode_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,10,10"/>
                                <Button Content="Eliminar"
                                        Click="Delete_Click"
                                        Style="{StaticResource DangerButton}"
                                        Margin="0,0,10,10"/>
                                <Button Content="Balancear"
                                        Click="Balancear_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,10"/>
                                <Button Content="Limpiar arbol"
                                        Click="Limpiar_Click"
                                        Style="{StaticResource DangerButton}"
                                        Margin="0,0,10,10"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Insercion manual -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Insercion manual"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Nodo padre" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtPadre" Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Nuevo valor"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,12,0,6"/>
                            <TextBox x:Name="txtNuevoValor" Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Posicion del hijo"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,12,0,6"/>
                            <ComboBox x:Name="cbPosicion"
                                      Style="{StaticResource ComboStyle}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Izquierda"/>
                                <ComboBoxItem Content="Derecha"/>
                            </ComboBox>

                            <Button x:Name="BtnInsertarRaiz"
                                    Content="Insertar raiz"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnInsertarRaiz_Click"
                                    Margin="0,16,0,10"/>
                            <Button x:Name="BtnInsertarManual"
                                    Content="Insertar en posicion"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnInsertarManual_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Propiedades -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Propiedades"
                                       Style="{StaticResource SectionTitle}"/>

                            <Button x:Name="BtnEsCompleto"
                                    Click="BtnEsCompleto_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Arbol completo?"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEsCompleto"
                                               Text="Verificar"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnEsPerfecto"
                                    Click="BtnEsPerfecto_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Arbol perfecto?"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEsPerfecto"
                                               Text="Verificar"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNodoRaiz"
                                    Content="Ver nodo raiz"
                                    Click="BtnNodoRaiz_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,10"/>

                            <Separator Margin="0,6,0,14"/>

                            <TextBlock Text="Busqueda del arbol"
                                       Style="{StaticResource SectionTitle}"/>

                            <Button x:Name="BtnEncontrarMinimo"
                                    Content="Buscar minimo"
                                    Click="BtnEncontrarMinimo_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Resultado minimo"
                                       Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="TxtMinimo"
                                     Text=""
                                     IsReadOnly="True"
                                     Style="{StaticResource InputStyle}"
                                     Margin="0,0,0,10"/>

                            <Button x:Name="BtnEncontrarMaximo"
                                    Content="Buscar maximo"
                                    Click="BtnEncontrarMaximo_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Resultado maximo"
                                       Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="TxtMaximo"
                                     Text=""
                                     IsReadOnly="True"
                                     Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ─── PANEL DERECHO ─── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*" MinHeight="500"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Metricas -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource MetricCard}"
                                Background="{StaticResource BgCard}">
                            <StackPanel>
                                <TextBlock Text="Nodos totales"
                                           Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="TxtNodos"
                                           Text="0"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Primary}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource MetricCard}"
                                Background="{StaticResource SuccessSoft}">
                            <StackPanel>
                                <TextBlock Text="Altura"
                                           Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="TxtAltura"
                                           Text="0"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}"
                                Padding="16,14"
                                Background="{StaticResource WarningSoft}">
                            <StackPanel>
                                <TextBlock Text="Estado"
                                           Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="TxtEstado"
                                           Text="Listo para operar"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Canvas principal del arbol -->
                    <Border Grid.Row="2"
                            Style="{StaticResource CardStyle}"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,18,18,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Visualizacion del arbol"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="El canvas crece automaticamente segun los nodos insertados. Usa el scroll para ver el arbol completo."
                                               Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{StaticResource BgSoft}"
                                        CornerRadius="12" Padding="12,8"
                                        VerticalAlignment="Top"/>
                            </Grid>


                            <Border Grid.Row="1"
                                    Margin="18,0,18,18"
                                    Background="{StaticResource CanvasBg}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PanningMode="Both">
                                    <Canvas x:Name="canvas"
                                            Background="{StaticResource CanvasBg}"
                                            Width="900"
                                            Height="560"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Recorridos -->
                    <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recorridos"
                                       Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="PreOrden"
                                        Click="Preorden_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,10,10"/>
                                <Button Content="InOrden"
                                        Click="Inorden_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,10"/>
                                <Button Content="PostOrden"
                                        Click="Postorden_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,10"/>
                            </WrapPanel>

                            <Border Background="{StaticResource BgSoft}"
                                    CornerRadius="14" Padding="14"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1">
                                <TextBlock x:Name="txtResultado"
                                           Text="Selecciona un recorrido o realiza una operacion para ver el resultado."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

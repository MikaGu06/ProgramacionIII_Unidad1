<UserControl x:Class="ProgramacionIII_Unidad1.EstructurasNoLineales.ArbolBinario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="920"
             d:DesignWidth="1280"
             Background="#E8E2F2">

    <UserControl.Resources>
        <!-- Paleta del segundo UserControl -->
        <SolidColorBrush x:Key="ColorPrimario" Color="#7F73A1"/>
        <SolidColorBrush x:Key="ColorPrimarioHover" Color="#262233"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#8A4D67"/>

        <SolidColorBrush x:Key="PrimarioSuave" Color="#9B8DBE"/>
        <SolidColorBrush x:Key="FondoLavanda" Color="#E8E2F2"/>
        <SolidColorBrush x:Key="Card" Color="White"/>
        <SolidColorBrush x:Key="InputColor" Color="#F7F5FA"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#DDD8E7"/>

        <SolidColorBrush x:Key="TextoOscuro" Color="#262233"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#726C80"/>

        <SolidColorBrush x:Key="AcentoRosa" Color="#C9A3C8"/>
        <SolidColorBrush x:Key="AcentoVerde" Color="#E1ECE3"/>
        <SolidColorBrush x:Key="WarningSoft" Color="#FFF4E8"/>
        <SolidColorBrush x:Key="SuccessSoft" Color="#E1ECE3"/>
        <SolidColorBrush x:Key="BgSoft" Color="#F7F5FA"/>

        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo de botón primario con efecto hover y escala -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorPrimarioHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón secundario basado en primario -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="Background" Value="{StaticResource PrimarioSuave}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón de peligro -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource ColorAlerta}"/>
        </Style>

        <!-- Estilo de tarjeta -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- Estilo de texto de título -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoClaro}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoClaro}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Estilo de input -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Estilo para botones informativos -->
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.04" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.04" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#15000000" BlurRadius="18"
                          ShadowDepth="2" Opacity="0.18"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource FondoLavanda}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ ENCABEZADO ══ -->
        <Border Grid.Row="0"
                Background="{StaticResource Card}"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="0,0,0,1.5"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RegresarInicio" 
                            Style="{StaticResource BtnGhost}" Width="42" Margin="0,0,18,0" Click="RegresarInicio_Click">
                        <TextBlock Text="←" FontSize="20"/>
                    </Button>

                    <StackPanel>
                        <TextBlock Text="Árbol Binario"
                                   Style="{StaticResource TitleText}"
                                   FontSize="28"/>
                        <TextBlock Text="Construye, visualiza, recorre y analiza el árbol. El canvas se expande automáticamente para mostrar todos los nodos."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimarioSuave}"
                        CornerRadius="14" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Modo actual"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextoOscuro}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="BST / Manual"
                                   Foreground="{StaticResource Card}"
                                   FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ CONTENIDO ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── PANEL IZQUIERDO ─── -->
                <StackPanel Grid.Column="0">

                    <!-- Operaciones principales -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Operaciones principales"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Valor" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtNodeValue"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Ingresa un número entero o un carácter"/>

                            <TextBlock Text="Tipo de dato"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbIntegers"
                                             Content="Enteros"
                                             IsChecked="True"
                                             Style="{StaticResource RadioStyle}"/>
                                <RadioButton x:Name="rbCharacters"
                                             Content="Caracteres"
                                             Style="{StaticResource RadioStyle}"/>
                            </StackPanel>

                            <WrapPanel Margin="0,19,0,0" ItemHeight="50" ItemWidth="160">
                                <Button Content="Añadir (BST)"
                                        Click="AddNode_Click"
                                        Style="{StaticResource BtnPrimary}"
                                        Margin="0,0,10,10"/>
                                <Button Content="Eliminar"
                                        Click="Delete_Click"
                                        Style="{StaticResource BtnDanger}"
                                        Margin="0,0,10,10"/>
                                <Button Content="Balancear"
                                        Click="Balancear_Click"
                                        Style="{StaticResource BtnSecondary}"
                                        Margin="0,0,10,10"/>
                                <Button Content="Limpiar árbol"
                                        Click="Limpiar_Click"
                                        Style="{StaticResource BtnDanger}"
                                        Margin="0,0,10,10"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Inserción manual -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Inserción manual"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Nodo padre" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtPadre" Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Nuevo valor"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,12,0,6"/>
                            <TextBox x:Name="txtNuevoValor" Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Posición del hijo"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,12,0,6"/>
                            <ComboBox x:Name="cbPosicion"
                                      Style="{StaticResource ComboStyle}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Izquierda"/>
                                <ComboBoxItem Content="Derecha"/>
                            </ComboBox>

                            <Button x:Name="BtnInsertarRaiz"
                                    Content="Insertar raíz"
                                    Style="{StaticResource BtnPrimary}"
                                    Click="BtnInsertarRaiz_Click"
                                    Margin="0,16,0,10"/>
                            <Button x:Name="BtnInsertarManual"
                                    Content="Insertar en posición"
                                    Style="{StaticResource BtnSecondary}"
                                    Click="BtnInsertarManual_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Propiedades -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Propiedades"
                                       Style="{StaticResource SectionTitle}"/>

                            <Button x:Name="BtnEsCompleto"
                                    Click="BtnEsCompleto_Click"
                                    Style="{StaticResource InfoButtonStyle}"
                                    Background="{StaticResource AcentoVerde}"
                                    BorderBrush="{StaticResource BordesSuaves}"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="¿Árbol completo?"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEsCompleto"
                                               Text="Verificar"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnEsPerfecto"
                                    Click="BtnEsPerfecto_Click"
                                    Style="{StaticResource InfoButtonStyle}"
                                    Background="{StaticResource FondoLavanda}"
                                    BorderBrush="{StaticResource BordesSuaves}"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="¿Árbol perfecto?"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEsPerfecto"
                                               Text="Verificar"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNodoRaiz"
                                    Content="Ver nodo raíz"
                                    Click="BtnNodoRaiz_Click"
                                    Style="{StaticResource BtnSecondary}"
                                    Margin="0,0,0,10"/>

                            <Separator Margin="0,6,0,14"/>

                            <TextBlock Text="Búsqueda en el árbol"
                                       Style="{StaticResource SectionTitle}"/>

                            <Button x:Name="BtnEncontrarMinimo"
                                    Content="Buscar mínimo"
                                    Click="BtnEncontrarMinimo_Click"
                                    Style="{StaticResource BtnSecondary}"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Resultado mínimo"
                                       Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="TxtMinimo"
                                     Text=""
                                     IsReadOnly="True"
                                     Style="{StaticResource InputStyle}"
                                     Margin="0,0,0,10"/>

                            <Button x:Name="BtnEncontrarMaximo"
                                    Content="Buscar máximo"
                                    Click="BtnEncontrarMaximo_Click"
                                    Style="{StaticResource BtnSecondary}"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Resultado máximo"
                                       Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="TxtMaximo"
                                     Text=""
                                     IsReadOnly="True"
                                     Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ─── PANEL DERECHO ─── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*" MinHeight="500"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Métricas -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource MetricCard}"
                                Background="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Nodos totales"
                                           Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="TxtNodos"
                                           Text="0"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorPrimario}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource MetricCard}"
                                Background="{StaticResource SuccessSoft}">
                            <StackPanel>
                                <TextBlock Text="Altura"
                                           Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="TxtAltura"
                                           Text="0"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextoOscuro}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}"
                                Padding="16,14"
                                Background="{StaticResource WarningSoft}">
                            <StackPanel>
                                <TextBlock Text="Estado"
                                           Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="TxtEstado"
                                           Text="Listo para operar"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextoOscuro}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Canvas principal del árbol -->
                    <Border Grid.Row="2"
                            Style="{StaticResource CardStyle}"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,18,18,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Visualización del árbol"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="El canvas crece automáticamente según los nodos insertados. Usa el scroll para ver el árbol completo."
                                               Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{StaticResource BgSoft}"
                                        CornerRadius="12" Padding="12,8"
                                        VerticalAlignment="Top"/>
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="18,0,18,18"
                                    Background="{StaticResource InputColor}"
                                    BorderBrush="{StaticResource BordesSuaves}"
                                    BorderThickness="1.5"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PanningMode="Both">
                                    <Canvas x:Name="canvas"
                                            Background="{StaticResource InputColor}"
                                            Width="900"
                                            Height="560"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Recorridos -->
                    <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recorridos"
                                       Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="PreOrden"
                                        Click="Preorden_Click"
                                        Style="{StaticResource BtnPrimary}"
                                        Margin="0,0,10,10"/>
                                <Button Content="InOrden"
                                        Click="Inorden_Click"
                                        Style="{StaticResource BtnSecondary}"
                                        Margin="0,0,10,10"/>
                                <Button Content="PostOrden"
                                        Click="Postorden_Click"
                                        Style="{StaticResource BtnSecondary}"
                                        Margin="0,0,10,10"/>
                            </WrapPanel>

                            <Border Background="{StaticResource BgSoft}"
                                    CornerRadius="14" Padding="14"
                                    BorderBrush="{StaticResource BordesSuaves}"
                                    BorderThickness="1">
                                <TextBlock x:Name="txtResultado"
                                           Text="Selecciona un recorrido o realiza una operación para ver el resultado."
                                           Foreground="{StaticResource TextoClaro}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
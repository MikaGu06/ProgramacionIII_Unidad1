<Page x:Class="ProgramacionIII_Unidad1.Inicio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProgramacionIII_Unidad1"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Inicio">
    <Page.Resources>
        <Style x:Key="TarjetaAnimada" TargetType="Border">

            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>

            <!-- sombra -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="2"
                                      Opacity="0.25"/>

                </Setter.Value>
            </Setter>

            <!-- animación -->
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>

                                <DoubleAnimation
                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                            To="1.1" Duration="0:0:0.2"/>

                                <DoubleAnimation
                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                            To="1.05" Duration="0:0:0.2"/>

                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>

                                <DoubleAnimation
                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                            To="1" Duration="0:0:0.2"/>

                                <DoubleAnimation
                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                            To="1" Duration="0:0:0.2"/>

                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>

                </Trigger>

            </Style.Triggers>

        </Style>
        <Style x:Key="RoundedButton" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7C6FA6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                Property="Background"
                                Value="#262233"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                Property="Background"
                                Value="#262233"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Page.Resources>

    <Grid Margin="30" >

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,30">
            <TextBlock Text="Visualizador de Algoritmos"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#262233"
                       HorizontalAlignment="Center"
                       />

            <TextBlock Text="Explora, aprende y visualiza algoritmos y estructuras de datos de manera interactiva"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                            Style="{StaticResource TarjetaAnimada}"
                            Margin="12"
                            Height="220"
                            Width="220"
                            BorderBrush="#9B8DBE"
                            BorderThickness="0,6,0,0">

                    <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="10">
                        <TextBlock Text="📊" 
                                       FontSize="36"
                                       HorizontalAlignment="Center"
                                       Foreground="#7F73A1"/>

                        <TextBlock Text="Ordenamiento"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,8,0,15"
                                       HorizontalAlignment="Center"/>

                        <Button Style="{StaticResource RoundedButton}"
                                    x:Name="BtnAbrirOrdenamiento"
                                    Content="Abrir"
                                    Width="90"
                                    Height="32" Click="BtnAbrirOrdenamiento_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource TarjetaAnimada}"
                        Margin="12" 
                        Background="White" 
                        Height="220"
                        Width="220"
                        BorderBrush="#8A4D67"
                        BorderThickness="0,6,0,0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="10">
                        <TextBlock Text="🔎"
                                   FontSize="36"
                                   Foreground="#8A4D67"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Busqueda"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,8,0,15"
                                   HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource RoundedButton}"
                                Content="Abrir"
                                Width="90"
                                Height="32"
                                Click="BtnAbrirBusqueda_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" 
                        Style="{StaticResource TarjetaAnimada}"
                        Margin="12" 
                        Width="220"
                        Background="White" 
                        Height="220"
                        BorderBrush="#E1ECE3"
                        BorderThickness="0,6,0,0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="10">
                        <TextBlock Text="📋"
                                   FontSize="36"
                                   Foreground="#5F6F66"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Estructuras Lineales"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,8,0,15"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="EstructurasLinealesBtn"
                            Style="{StaticResource RoundedButton}"
                                Content="Abrir"
                                Width="90"
                                Height="32" Click="EstructurasLinealesBtn_Click"/>
                    </StackPanel>
                </Border>

            </Grid>

            <Grid Grid.Row="1" HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Style="{StaticResource TarjetaAnimada}"
                        Margin="12" 
                        Background="White" 
                        Height="220"
                        Width="220"
                        BorderBrush="#E1ECE3"
                        BorderThickness="0,6,0,0">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="10">
                        <TextBlock Text="🔁"
                                   FontSize="36"
                                   Foreground="#5F6F66"
                                   HorizontalAlignment="Center" Cursor=""/>
                        <TextBlock Text="Recursividad"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,8,0,15"
                                   HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource RoundedButton}"
                                Content="Abrir"
                                Width="90"
                                Height="32"
                                Click="BtnAbrirRecursividad_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource TarjetaAnimada}"
                        Margin="12" 
                        Background="White" 
                        Height="220" 
                        Width="220"
                        BorderBrush="#8A4D67"
                        BorderThickness="0,6,0,0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="10">
                        <TextBlock Text="🌳"
                                   FontSize="36"
                                   Foreground="#8A4D67"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Estructuras no lineales"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,8,0,15"
                                   HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource RoundedButton}"
                                Content="Abrir"
                                Width="90"
                                Height="32"
                                Click="BtnAbrirNoLineales_Click"/>
                    </StackPanel>
                </Border>

            </Grid>

        </Grid>

    </Grid>
</Page>
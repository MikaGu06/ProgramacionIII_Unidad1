<UserControl x:Class="ProgramacionIII_Unidad1.Hanoi"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="500" Width="700">

    <UserControl.Resources>
        
        <SolidColorBrush x:Key="ColorPrimario" Color="#7F73A1"/>
        <SolidColorBrush x:Key="ColorPrimarioHover" Color="#262233"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#8A4D67"/>
        <SolidColorBrush x:Key="Card" Color="White"/>
        <SolidColorBrush x:Key="InputColor" Color="#F7F5FA"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#DDD8E7"/>
        <SolidColorBrush x:Key="TextoOscuro" Color="#262233"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#726C80"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorPrimarioHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.05" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.05" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Card}" 
            CornerRadius="16" 
            Margin="10" 
            BorderBrush="{StaticResource BordesSuaves}" 
            BorderThickness="1">
        <StackPanel Margin="5">

            <TextBlock Text="Torres de Hanói"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextoOscuro}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Mueve todos los discos de la torre A a la torre C"
                       FontSize="12"
                       Foreground="{StaticResource TextoClaro}"
                       HorizontalAlignment="Center"
                       />

            <Border Background="{StaticResource InputColor}" 
                    CornerRadius="12" 
                    Padding="10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Número de discos:" 
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextoOscuro}"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="txtDiscos" 
                                 Grid.Column="1"
                                 Style="{StaticResource InputStyle}"
                                 
                                 Margin="0,0,15,0"/>

                        <Button Grid.Column="2"
                                x:Name="BtnIniciar"
                                Content="Inicio"
                                Style="{StaticResource BtnPrimary}"
                                Click="BtnIniciar_Click"
                                Width="120"
                                HorizontalAlignment="Left"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <TextBlock Text="Velocidad:" 
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextoOscuro}"
                                   Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbLento" 
                                     Content="Lento" 
                                     Style="{StaticResource RadioButtonStyle}"
                                     GroupName="Velocidad"
                                     Tag="2000"/>
                        <RadioButton x:Name="rbNormal" 
                                     Content="Normal" 
                                     Style="{StaticResource RadioButtonStyle}"
                                     GroupName="Velocidad"
                                     IsChecked="True"
                                     Tag="800"/>
                        <RadioButton x:Name="rbRapido" 
                                     Content="Rápido" 
                                     Style="{StaticResource RadioButtonStyle}"
                                     GroupName="Velocidad"
                                     Tag="300"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Height="270" Background="{StaticResource InputColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- TORRE A -->
                <Grid Grid.Column="0" Margin="10">
                    <Border Background="Gray" 
                            Width="6" 
                            Height="220"
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Center"
                            CornerRadius="3"/>
                    <TextBlock Text="Torre A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource TextoClaro}"
                               Margin="0,10,0,0"
                               FontWeight="Bold"/>
                    <StackPanel x:Name="TorreA"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10"/>
                </Grid>

                <!-- TORRE B -->
                <Grid Grid.Column="1" Margin="10">
                    <Border Background="Gray" 
                            Width="6" 
                            Height="220"
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Center"
                            CornerRadius="3"/>
                    <TextBlock Text="Torre B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource TextoClaro}"
                               Margin="0,10,0,0"
                               FontWeight="Bold"/>
                    <StackPanel x:Name="TorreB"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10"/>
                </Grid>

                <!-- TORRE C -->
                <Grid Grid.Column="2" Margin="10">
                    <Border Background="Gray" 
                            Width="6" 
                            Height="220"
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Center"
                            CornerRadius="3"/>
                    <TextBlock Text="Torre C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource TextoClaro}"
                               Margin="0,10,0,0"
                               FontWeight="Bold"/>
                    <StackPanel x:Name="TorreC"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10"/>
                </Grid>
            </Grid>

            <Border Background="{StaticResource ColorPrimario}" 
                    CornerRadius="12" 
                    Padding="10" 
                    Margin="0,5,0,0">
                <TextBlock x:Name="lblPasos"
                           Text="Pasos: 0"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
<UserControl x:Class="ProgramacionIII_Unidad1.Hanoi"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="450" Width="600">

    <StackPanel>

        <TextBlock Text="Torres de Hanói"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBox x:Name="txtDiscos" Width="60" Text="3" Margin="5"/>
            <Button Content="Iniciar" Width="120" Click="BtnIniciar_Click"/>
        </StackPanel>

        <Grid Height="280" Background="#F0F2F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- TORRE A -->
            <Grid Grid.Column="0">
                <Border Background="Gray" Width="6" Height="200"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                <StackPanel x:Name="TorreA"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"/>
            </Grid>

            <!-- TORRE B -->
            <Grid Grid.Column="1">
                <Border Background="Gray" Width="6" Height="200"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                <StackPanel x:Name="TorreB"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"/>
            </Grid>

            <!-- TORRE C -->
            <Grid Grid.Column="2">
                <Border Background="Gray" Width="6" Height="200"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                <StackPanel x:Name="TorreC"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"/>
            </Grid>
        </Grid>

        <TextBlock x:Name="lblPasos"
                   Text="Pasos: 0"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="10"/>
    </StackPanel>
</UserControl>
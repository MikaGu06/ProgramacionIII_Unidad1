<Page x:Class="ProgramacionIII_Unidad1.AlgoritmosDeOrdenamiento"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProgramacionIII_Unidad1"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1280"
      Title="AlgoritmosDeOrdenamiento">

    <Page.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="#726C80"/>
            <Setter Property="Background" Value="#262233"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#262233"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlgButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1E1B4B"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="BorderBrush" Value="#DDD8E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E0E7FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7F73A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#F7F5FA"/>
            <Setter Property="BorderBrush" Value="#DDD8E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBlockDarkColor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#262233"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>


        </Style>

        <Style x:Key="TextBlockLightColor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#726C80"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>


        </Style>
    </Page.Resources>
    
    <!--grid-->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!--titulo-->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="BtnVolver"
                        Content="←" FontSize="20" Background="White" Foreground="#8A4D67" 
                        Width="45" Height="45" VerticalAlignment="Top" Style="{StaticResource RoundedButton}" Click="BtnVolver_Click"/>

                <StackPanel Margin="20,0,0,0">
                    <TextBlock Text="Algoritmos de Ordenamiento" 
                               FontSize="36" 
                               FontWeight="Bold" 
                               Foreground="#726C80"/>
                    <TextBlock Text="Visualiza y compara diferentes algoritmos de ordenamiento"
                               FontSize="16" 
                               Foreground="#475569" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <!--card-->
            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.1" Color="Black"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Configuración del Arreglo" FontSize="24" FontWeight="Bold" Style="{StaticResource TextBlockDarkColor}"/>
                    <TextBlock Text="Genera números aleatorios o agrega tus propios elementos" FontSize="14" Style="{StaticResource TextBlockLightColor}" Margin="0,5,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                     

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Agregar elemento" Style="{StaticResource TextBlockDarkColor}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtBxIngresarVector" Grid.Row="3" Grid.Column="0" Tag="Ingresa un número" Style="{StaticResource RoundedTextBox}" Margin="0,0,20,0"/>
                        <Button x:Name="BtnAgregar" Click="BtnAgregar_Click" Grid.Row="3" Grid.Column="1" Content="+ Agregar" Background="#7F73A1" Foreground="White" Style="{StaticResource RoundedButton}"/>
                        <Button x:Name="BtnRandom" Content="🎲 Aleatorio" Background="#262233" Foreground="White" Style="{StaticResource RoundedButton}" Margin="2" Click="BtnRandom_Click"/>
                    </Grid>

                    <TextBlock Text="Vector original" Style="{StaticResource TextBlockDarkColor}" Margin="0,30,0,10"/>
                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="15" MinHeight="80">
                        <ItemsControl x:Name="ICVectorOriginal">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#DDD8E7" BorderThickness="2" CornerRadius="5" Padding="12,8" Margin="5">
                                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="16"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="Tipo de ordenamiento" Style="{StaticResource TextBlockDarkColor}" Margin="0,30,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="radBtnAsc" Content="↑ Ascendente (menor a mayor)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,30,0" Foreground="#334155" FontSize="16"/>
                        <RadioButton x:Name="radBtnDes" Content="↓ Descendente (mayor a menor)" FontWeight="SemiBold" Foreground="#334155" FontSize="16"/>
                    </StackPanel>

                    <TextBlock Text="Elegir algoritmo" Style="{StaticResource TextBlockDarkColor}" Margin="0,30,0,10"/>

                    <UniformGrid Columns="5" Rows="2">
                        <Button x:Name="BtnSeleccion" Click="BtnSeleccion_Click" Content="Selección" Style="{StaticResource AlgButton}"/>
                        <Button x:Name="BtnInsercion" Content="Inserción" Style="{StaticResource AlgButton}" Click="BtnInsercion_Click"/>
                        <Button x:Name="BtnIntercambio" Content="Intercambio" Style="{StaticResource AlgButton}" Click="BtnIntercambio_Click"/>
                        <Button x:Name="BtnBurbuja" Content="Burbuja" Style="{StaticResource AlgButton}" Click="BtnBurbuja_Click"/>
                        <Button x:Name="BtnQuickSort" Content="Quick Sort" Style="{StaticResource AlgButton}" Click="BtnQuickSort_Click"/>

                        <Button x:Name="BtnMergeSort" Content="Merge Sort" Style="{StaticResource AlgButton}" Click="BtnMergeSort_Click"/>
                        <Button x:Name="BtnRadixSort" Content="Radix Sort" Style="{StaticResource AlgButton}" Click="BtnRadixSort_Click"/>
                        <Button x:Name="BtnBucketSort" Content="Bucket Sort" Style="{StaticResource AlgButton}" Click="BtnBucketSort_Click"/>
                        <Button x:Name="BtnShell" Content="Shell" Style="{StaticResource AlgButton}" Click="BtnShell_Click"/>
                        <Button x:Name="BtnMonticulo" Content="Montículo" Style="{StaticResource AlgButton}" Click="BtnMonticulo_Click"/>
                    </UniformGrid>

                    <StackPanel x:Name="PanelResultado" Visibility="Visible">
                        <Separator Margin="0,30,0,20" Background="#E2E8F0"/>
                        <TextBlock Text="Vector ordenado" Style="{StaticResource TextBlockDarkColor}" Margin="0,0,0,10"/>
                        <Border Background="#F0FDF4" BorderBrush="#E1ECE3" BorderThickness="1" CornerRadius="8" Padding="15" MinHeight="80">
                            <ItemsControl x:Name="ICVectorOrdenado">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E1ECE3" BorderThickness="2" CornerRadius="5" Padding="12,8" Margin="5">
                                            <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#15803D" FontSize="16"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBox x:Name="TxtComplexity" 
                                 Text="Complejidad: ---" 
                                 Margin="5,10,0,0" 
                                 Foreground="#64748B" 
                                 FontSize="14" 
                                 FontStyle="Italic" 
                                 IsReadOnly="True" 
                                 BorderThickness="0" 
                                 Background="Transparent"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
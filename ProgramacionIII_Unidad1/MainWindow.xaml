<Window x:Class="ProgramacionIII_Unidad1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProgramacionIII_Unidad1"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280">
    
        <Window.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <!-- esquina superior izquierda (gris/blanco suave) -->
                <GradientStop Color="#F7F8FC" Offset="0"/>

                <!-- transición celeste pastel -->
                <GradientStop Color="#E7EEFF" Offset="0.35"/>

                <!-- mezcla celeste-lila -->
                <GradientStop Color="#DDD9F3" Offset="0.65"/>

                <!-- esquina inferior derecha (lila pastel) -->
                <GradientStop Color="#CFC8F4" Offset="1"/>
            </LinearGradientBrush>
        </Window.Background>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />

    
</Window>

<Window x:Class="ProgramacionIII_Unidad1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProgramacionIII_Unidad1"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

            <!-- esquina superior izquierda (crema muy suave) -->
            <GradientStop Color="#F7F5FA" Offset="0"/>

            <!-- transición lavanda clara -->
            <GradientStop Color="#E8E2F2" Offset="0.35"/>

            <!-- mezcla lavanda gris -->
            <GradientStop Color="#DDD8E7" Offset="0.65"/>

            <!-- esquina inferior derecha (lavanda más marcada) -->
            <GradientStop Color="#CFC8F4" Offset="1"/>

        </LinearGradientBrush>
    </Window.Background>
    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />


</Window>

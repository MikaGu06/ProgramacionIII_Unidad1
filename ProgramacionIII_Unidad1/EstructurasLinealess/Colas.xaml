<UserControl x:Class="ProgramacionIII_Unidad1.EstructurasLinealess.Colas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProgramacionIII_Unidad1.EstructurasLinealess"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorPrimario" Color="#7F73A1"/>
        <SolidColorBrush x:Key="ColorPrimarioHover" Color="#262233"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#8A4D67"/>
        <SolidColorBrush x:Key="PrimarioSuave" Color="#9B8DBE"/>
        <SolidColorBrush x:Key="FondoLavanda" Color="#E8E2F2"/>
        <SolidColorBrush x:Key="Card" Color="White"/>
        <SolidColorBrush x:Key="InputColor" Color="#F7F5FA"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#DDD8E7"/>
        <SolidColorBrush x:Key="TextoOscuro" Color="#262233"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#726C80"/>
        <SolidColorBrush x:Key="AcentoRosa" Color="#C9A3C8"/>
        <SolidColorBrush x:Key="AcentoVerde" Color="#E1ECE3"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorPrimarioHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource ColorAlerta}"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.04" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.04" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="95"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,22">
            <TextBlock Text="Cola (Queue)"
                       FontSize="18"
                       FontFamily="Segoe UI Semibold"
                       Foreground="{StaticResource TextoOscuro}"/>
            <TextBlock Text="FIFO - First In, First Out"
                       FontSize="14"
                       Foreground="{StaticResource TextoClaro}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Fila 1: insertar manual -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Cursor="">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtTamMax"
         Grid.Column="0"
         Style="{StaticResource InputStyle}"
         Margin="0,0,12,0"
         HorizontalAlignment="Left"
         ToolTip="Tamaño máximo"/>
            <Button x:Name="BtnGenerarAleatorio"
        Grid.Column="1"
        Style="{StaticResource BtnPrimary}"
        Content="Generar automático"
        Click="BtnGenerarAleatorio_Click"/>

        </Grid>

        <!-- Fila 2: generar vector -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtCantidadAleatoria"
                     Grid.Column="0"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,12,0"
                     HorizontalAlignment="Left"
                     ToolTip="Cantidad de elementos aleatorios"/>

            
            <Button x:Name="BtnInsertar"
Grid.Column="1"
Style="{StaticResource BtnPrimary}"
Content="Insertar"
Click="BtnInsertar_Click"/>
        </Grid>

        <!-- Fila 3 -->
        <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,16,0" Cursor="">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnQuitar"
                    Grid.Column="0"
                    Style="{StaticResource BtnDanger}"
                    Margin="0,0,12,0"
                    Content="Quitar"
                    Click="BtnQuitar_Click"/>

            <Button x:Name="BtnLimpiar"
                    Grid.Column="1"
                    Style="{StaticResource BtnPrimary}"
                    Content="Limpiar"
                    Click="BtnLimpiar_Click"/>
        </Grid>

        <!-- Info -->
        <UniformGrid Grid.Row="4" Grid.ColumnSpan="2" Columns="4" Margin="0,20,0,0">

            <Button x:Name="BtnVacia"
                    Style="{StaticResource InfoButtonStyle}"
                    Background="#F2EAE0"
                    BorderBrush="#DDD8E7"
                    Margin="0,0,12,0" Click="BtnVacia_Click">
                <StackPanel>
                    <TextBlock Text="¿Está vacía?"
                               FontSize="14"
                               Foreground="{StaticResource TextoOscuro}"/>
                    <TextBlock x:Name="TxtVacia"
                               Text="-"
                               FontSize="18"
                               FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource TextoOscuro}" Cursor=""/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnLlena"
                    Style="{StaticResource InfoButtonStyle}"
                    Background="#E8E2F2"
                    BorderBrush="#9B8DBE"
                    Margin="0,0,12,0" Click="BtnLlena_Click">
                <StackPanel>
                    <TextBlock Text="¿Está llena?"
                               FontSize="14"
                               Foreground="{StaticResource TextoOscuro}"/>
                    <TextBlock x:Name="TxtLlena"
                               Text="-"
                               FontSize="18"
                               FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource TextoOscuro}"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnMaximo"
                    Style="{StaticResource InfoButtonStyle}"
                    Background="#F1E0E7"
                    BorderBrush="#C9A3C8"
                    Margin="0,0,12,0"
                    Click="BtnMaximo_Click">
                <StackPanel>
                    <TextBlock Text="Tamaño máximo"
                               FontSize="14"
                               Foreground="#8A4D67"/>
                    <TextBlock x:Name="TxtMaximo"
                               Text="-"
                               FontSize="18"
                               FontFamily="Segoe UI Semibold"
                               Foreground="#8A4D67"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnCima"
                    Style="{StaticResource InfoButtonStyle}"
                    Background="#E1ECE3"
                    BorderBrush="#A8C2CC" Click="BtnCima_Click">
                <StackPanel>
                    <TextBlock Text="Cima"
                               FontSize="14"
                               Foreground="{StaticResource TextoOscuro}"/>
                    <TextBlock x:Name="TxtCima"
                               Text="-"
                               FontSize="18"
                               FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource TextoOscuro}"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Resultado -->
        <Border Grid.Row="5" Grid.ColumnSpan="2"
                Margin="0,24,0,18"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1.5"
                CornerRadius="16"
                Background="{StaticResource Card}"
                Padding="20">

            <StackPanel>
                <TextBlock Text="Resultado de la cola"
                           FontSize="15"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"
                           Margin="0,0,0,14"/>

                <ListBox x:Name="LstCola"
                         Height="120"
                         Background="{StaticResource InputColor}"
                         BorderBrush="{StaticResource BordesSuaves}"
                         BorderThickness="1"
                         FontSize="16"
                         Foreground="{StaticResource TextoOscuro}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Contador -->
        <Border Grid.Row="6"
                Grid.Column="0"
                Background="{StaticResource FondoLavanda}"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,4"
                HorizontalAlignment="Left">
            <TextBlock x:Name="TxtElementos"
                       Text="Elementos: 0"
                       Foreground="{StaticResource TextoOscuro}"
                       FontSize="14"/>
        </Border>
    </Grid>

</UserControl>

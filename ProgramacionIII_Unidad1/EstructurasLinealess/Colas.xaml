<UserControl x:Class="ProgramacionIII_Unidad1.EstructurasLinealess.Colas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProgramacionIII_Unidad1.EstructurasLinealess"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorPrimario" Color="#6A5AE0"/>
        <SolidColorBrush x:Key="Card" Color="#F8F8FC"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#D9D5F3"/>
        <SolidColorBrush x:Key="TextoOscuro" Color="#18214D"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#6B7280"/>
        <SolidColorBrush x:Key="InputColor" Color="#F1F3F9"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#F46A6A"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource ColorAlerta}"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,22">
            <TextBlock Text="Cola (Queue)"
                       FontSize="18"
                       FontFamily="Segoe UI Semibold"
                       Foreground="{StaticResource TextoOscuro}"/>
            <TextBlock Text="FIFO - First In, First Out"
                       FontSize="14"
                       Foreground="{StaticResource TextoClaro}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Fila 1 -->
        <TextBox x:Name="TxtNumero"
                 Grid.Row="1" Grid.Column="0"
                 Style="{StaticResource InputStyle}"
                 Margin="0,0,16,0"/>

        <Button x:Name="BtnInsertar"
                Grid.Row="1" Grid.Column="1"
                Style="{StaticResource BtnPrimary}"
                Content="Insertar"/>

        <!-- Fila 2 -->
        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtTamMax"
                     Grid.Column="0"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,16,0"
                     ToolTip="Tamaño máximo"/>

            <Button x:Name="BtnQuitar"
                    Grid.Column="1"
                    Style="{StaticResource BtnDanger}"
                    Margin="0,0,12,0"
                    Content="Quitar"/>

            <Button x:Name="BtnLimpiar"
                    Grid.Column="2"
                    Style="{StaticResource BtnPrimary}"
                    Content="Limpiar"/>
        </Grid>

        <!-- Info -->
        <UniformGrid Grid.Row="3" Grid.ColumnSpan="2" Columns="4" Margin="0,20,0,0">
            <Border Style="{StaticResource InfoCardStyle}"
                    Background="#FFF7DB"
                    BorderBrush="#F4C400"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="¿Está vacía?"
                               FontSize="14"
                               Foreground="#8A5A00"/>
                    <TextBlock x:Name="TxtVacia"
                               Text="Sí"
                               FontSize="18"
                               FontFamily="Segoe UI Semibold"
                               Foreground="#8A5A00"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoCardStyle}"
                    Background="#FCE8DC"
                    BorderBrush="#F59E42"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="¿Está llena?"
                               FontSize="14"
                               Foreground="#A84B00"/>
                    <TextBlock x:Name="TxtLlena"
                               Text="No"
                               FontSize="18"
                               FontFamily="Segoe UI Semibold"
                               Foreground="#A84B00"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoCardStyle}"
                    Background="#E8F1FF"
                    BorderBrush="#6AA7FF"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Tamaño máximo"
                               FontSize="14"
                               Foreground="#214E9C"/>
                    <TextBlock x:Name="TxtMaximo"
                               Text="0"
                               FontSize="18"
                               FontFamily="Segoe UI Semibold"
                               Foreground="#214E9C"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoCardStyle}"
                    Background="#F3E8FF"
                    BorderBrush="#C084FC">
                <StackPanel>
                    <TextBlock Text="Front"
                               FontSize="14"
                               Foreground="#7A2BBE"/>
                    <TextBlock x:Name="TxtFront"
                               Text="-"
                               FontSize="18"
                               FontFamily="Segoe UI Semibold"
                               Foreground="#7A2BBE"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Resultado -->
        <Border Grid.Row="4" Grid.ColumnSpan="2"
                Margin="0,24,0,18"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1.5"
                CornerRadius="16"
                Background="#FCFCFF"
                Padding="20">

            <StackPanel>
                <TextBlock Text="Resultado de la cola"
                           FontSize="15"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"
                           Margin="0,0,0,14"/>

                <TextBox x:Name="TxtResultado"
                         Style="{StaticResource InputStyle}"
                         Height="160"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
            </StackPanel>
        </Border>

        <!-- Contador -->
        <Border Grid.Row="5"
                Grid.Column="0"
                Background="#F4F3FF"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,4"
                HorizontalAlignment="Left">
            <TextBlock x:Name="TxtElementos"
                       Text="Elementos: 0"
                       Foreground="{StaticResource TextoOscuro}"
                       FontSize="14"/>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="ProgramacionIII_Unidad1.EstructurasLinealess.ListasCircularesSimples"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProgramacionIII_Unidad1.EstructurasLinealess"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorPrimario" Color="#6A5AE0"/>
        <SolidColorBrush x:Key="Card" Color="#F8F8FC"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#D9D5F3"/>
        <SolidColorBrush x:Key="TextoOscuro" Color="#18214D"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#6B7280"/>
        <SolidColorBrush x:Key="InputColor" Color="#EEF0F8"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#F46A6A"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource ColorAlerta}"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.04" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.04" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrimarySmallHover" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.03" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.03" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="170"/>
        </Grid.ColumnDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,22">
            <TextBlock Text="Lista Circular Simple"
                       FontSize="18"
                       FontFamily="Segoe UI Semibold"
                       Foreground="{StaticResource TextoOscuro}"/>
            <TextBlock Text="El último nodo appunta al primero"
                       FontSize="14"
                       Foreground="{StaticResource TextoClaro}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Fila 1: ingreso manual -->
        <TextBox x:Name="TxtNumero"
                 Grid.Row="1" Grid.Column="0"
                 Style="{StaticResource InputStyle}"
                 Margin="0,0,16,0"/>

        <Button x:Name="BtnAgregarInicio"
                Grid.Row="1" Grid.Column="1"
                Style="{StaticResource BtnPrimary}"
                Margin="0,0,12,0"
                Content="Agregar al inicio"/>

        <Button x:Name="BtnAgregarFinal"
                Grid.Row="1" Grid.Column="2"
                Style="{StaticResource BtnPrimary}"
                Content="Agregar al final"/>

        <!-- Fila 2: generación aleatoria -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtCantidadAleatoria"
                     Grid.Column="0"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,12,0"
                     ToolTip="Cantidad de elementos aleatorios"/>

            <Button x:Name="BtnGenerarAleatorio"
                    Grid.Column="1"
                    Style="{StaticResource BtnPrimary}"
                    Content="Generar automático"/>
        </Grid>

        <!-- Fila 3: eliminar y buscar -->
        <Button x:Name="BtnEliminarInicio"
                Grid.Row="3" Grid.Column="0"
                Style="{StaticResource BtnDanger}"
                Width="170"
                HorizontalAlignment="Left"
                Content="Eliminar inicio"/>

        <Button x:Name="BtnEliminarFinal"
                Grid.Row="3" Grid.Column="0"
                Style="{StaticResource BtnDanger}"
                Width="170"
                HorizontalAlignment="Left"
                Margin="190,0,0,0"
                Content="Eliminar final"/>

        <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtBuscar"
                     Grid.Column="0"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,12,0"
                     Text=""/>

            <Button x:Name="BtnBuscar"
                    Grid.Column="1"
                    Style="{StaticResource BtnPrimary}"
                    Content="Buscar elemento"/>
        </Grid>

        <!-- Área visual -->
        <Border Grid.Row="4" Grid.ColumnSpan="3"
                Margin="0,24,0,18"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1.5"
                CornerRadius="16"
                Background="#FCFCFF"
                Padding="20">

            <StackPanel>
                <TextBlock Text="Visualización de la lista"
                           FontSize="15"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"
                           Margin="0,0,0,14"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="PanelLista"
                               Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Contador -->
        <Border Grid.Row="5"
                Grid.Column="0"
                Background="#F4F3FF"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,4"
                HorizontalAlignment="Left">
            <TextBlock x:Name="TxtElementos"
                       Text="Elementos: 0"
                       Foreground="{StaticResource TextoOscuro}"
                       FontSize="14"/>
        </Border>

        <!-- Card inferior -->
        <Border Grid.Row="7" Grid.ColumnSpan="3"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1.5"
                CornerRadius="16"
                Background="#FCFCFF"
                Padding="20">

            <StackPanel>
                <TextBlock Text="Estadísticas de la Lista"
                           FontSize="15"
                           FontFamily="Segoe UI Semibold"
                           Foreground="{StaticResource TextoOscuro}"/>

                <TextBlock Text="Información y operaciones sobre la lista"
                           FontSize="14"
                           Foreground="{StaticResource TextoClaro}"
                           Margin="0,4,0,18"/>

                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <Button x:Name="BtnEstaVacia"
                            Style="{StaticResource InfoButtonStyle}"
                            Background="#FFF7DB"
                            BorderBrush="#F4C400"
                            Margin="0,0,12,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="¿Está vacía?"
                                       FontSize="14"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#8A5A00"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtEstaVacia"
                                       Text="NO"
                                       FontSize="18"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#8A5A00"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnEstaLlena"
                            Style="{StaticResource InfoButtonStyle}"
                            Background="#FCE8DC"
                            BorderBrush="#F59E42"
                            Margin="0,0,12,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="¿Está llena?"
                                       FontSize="14"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#A84B00"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtEstaLlena"
                                       Text="NO"
                                       FontSize="18"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#A84B00"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnModa"
                            Style="{StaticResource InfoButtonStyle}"
                            Background="#FBE4F1"
                            BorderBrush="#F28CC4">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Moda"
                                       FontSize="14"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#B01F6D"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtModa"
                                       Text="-"
                                       FontSize="18"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#B01F6D"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Button x:Name="BtnSumaTotal"
                            Style="{StaticResource InfoButtonStyle}"
                            Background="#E8F1FF"
                            BorderBrush="#6AA7FF"
                            Margin="0,0,12,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Suma Total"
                                       FontSize="14"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#214E9C"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtSumaTotal"
                                       Text="Calcular"
                                       FontSize="18"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#214E9C"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMayor"
                            Style="{StaticResource InfoButtonStyle}"
                            Background="#F3E8FF"
                            BorderBrush="#C084FC"
                            Margin="0,0,12,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Mayor"
                                       FontSize="14"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#7A2BBE"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtMayor"
                                       Text="Calcular"
                                       FontSize="18"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#7A2BBE"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMenor"
                            Style="{StaticResource InfoButtonStyle}"
                            Background="#E3F6E8"
                            BorderBrush="#62D78B">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Menor"
                                       FontSize="14"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#137A3E"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtMenor"
                                       Text="Calcular"
                                       FontSize="18"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#137A3E"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Button x:Name="BtnLimpiarListaCompleta"
                        Style="{StaticResource BtnPrimarySmallHover}"
                        Content="Limpiar Lista"
                        Margin="0,0,0,18"
                        Background="#F46A6A"/>

                <Border Height="1"
                        Background="{StaticResource BordesSuaves}"
                        Margin="0,8,0,18"/>

                <StackPanel>
                    <TextBlock Text="Tipo de ordenamiento"
                               FontSize="14"
                               FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource TextoOscuro}"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="RbAscendente"
                                     Content="Ascendente"
                                     IsChecked="True"
                                     Margin="0,0,24,0"
                                     Foreground="{StaticResource TextoOscuro}"
                                     FontSize="14"/>

                        <RadioButton x:Name="RbDescendente"
                                     Content="Descendente"
                                     Foreground="{StaticResource TextoOscuro}"
                                     FontSize="14"/>
                    </StackPanel>

                    <Button x:Name="BtnOrdenarLista"
                            Style="{StaticResource BtnPrimarySmallHover}"
                            Content="Ordenar Lista"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

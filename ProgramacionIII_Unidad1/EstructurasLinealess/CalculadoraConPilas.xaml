<UserControl x:Class="ProgramacionIII_Unidad1.EstructurasLinealess.CalculadoraConPilas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProgramacionIII_Unidad1.EstructurasLinealess"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Paleta nueva -->
        <SolidColorBrush x:Key="ColorPrimario" Color="#7F73A1"/>
        <SolidColorBrush x:Key="ColorPrimarioHover" Color="#262233"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#8A4D67"/>
        <SolidColorBrush x:Key="PrimarioSuave" Color="#9B8DBE"/>
        <SolidColorBrush x:Key="FondoLavanda" Color="#E8E2F2"/>
        <SolidColorBrush x:Key="Card" Color="White"/>
        <SolidColorBrush x:Key="InputColor" Color="#F7F5FA"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#DDD8E7"/>
        <SolidColorBrush x:Key="TextoOscuro" Color="#262233"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#726C80"/>
        <SolidColorBrush x:Key="AcentoRosa" Color="#C9A3C8"/>
        <SolidColorBrush x:Key="AcentoVerde" Color="#E1ECE3"/>

        <!-- Colores específicos calculadora -->
        <SolidColorBrush x:Key="ColorNumero" Color="#F7F5FA"/>
        <SolidColorBrush x:Key="ColorOperador" Color="#E8E2F2"/>
        <SolidColorBrush x:Key="ColorIgual" Color="#7F73A1"/>
        <SolidColorBrush x:Key="ColorLimpiar" Color="#E1ECE3"/>
        <SolidColorBrush x:Key="ColorBorrar" Color="#F1E0E7"/>

        <Style x:Key="BtnCalc" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="Background" Value="{StaticResource ColorNumero}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEEAF5"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnOperador" TargetType="Button" BasedOn="{StaticResource BtnCalc}">
            <Setter Property="Background" Value="{StaticResource ColorOperador}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
        </Style>

        <Style x:Key="BtnIgual" TargetType="Button" BasedOn="{StaticResource BtnCalc}">
            <Setter Property="Background" Value="{StaticResource ColorIgual}"/>
            <Setter Property="Width" Value="168"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="BtnLimpiar" TargetType="Button" BasedOn="{StaticResource BtnCalc}">
            <Setter Property="Background" Value="{StaticResource ColorLimpiar}"/>
            <Setter Property="Width" Value="168"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="BorderBrush" Value="#C7D9CB"/>
        </Style>

        <Style x:Key="BtnBorrar" TargetType="Button" BasedOn="{StaticResource BtnCalc}">
            <Setter Property="Background" Value="{StaticResource ColorBorrar}"/>
            <Setter Property="Width" Value="168"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource ColorAlerta}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AcentoRosa}"/>
        </Style>

        <Style x:Key="DisplayStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Calculadora con pilas"
                   FontSize="18"
                   FontFamily="Segoe UI Semibold"
                   Foreground="{StaticResource TextoOscuro}"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="{StaticResource Card}"
                BorderBrush="{StaticResource BordesSuaves}"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="20">

            <StackPanel>
                <TextBlock Text="Expresiones y operaciones básicas"
                           FontSize="14"
                           Foreground="{StaticResource TextoClaro}"
                           Margin="0,6,0,18"/>

                <TextBox x:Name="TxtPantalla"
                         Style="{StaticResource DisplayStyle}"
                         Margin="0,0,0,18"/>

                <UniformGrid Columns="4">
                    <Button x:Name="Btn7" Content="7" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="Btn8" Content="8" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="Btn9" Content="9" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="BtnDiv" Content="/" Style="{StaticResource BtnOperador}" Click="AgregarTexto"/>

                    <Button x:Name="Btn4" Content="4" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="Btn5" Content="5" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="Btn6" Content="6" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="BtnMul" Content="*" Style="{StaticResource BtnOperador}" Click="AgregarTexto"/>

                    <Button x:Name="Btn1" Content="1" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="Btn2" Content="2" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="Btn3" Content="3" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="BtnRes" Content="-" Style="{StaticResource BtnOperador}" Click="AgregarTexto"/>

                    <Button x:Name="Btn0" Content="0" Style="{StaticResource BtnCalc}" Click="AgregarTexto"/>
                    <Button x:Name="BtnParA" Content="(" Style="{StaticResource BtnOperador}" Click="AgregarTexto"/>
                    <Button x:Name="BtnParC" Content=")" Style="{StaticResource BtnOperador}" Click="AgregarTexto"/>
                    <Button x:Name="BtnSum" Content="+" Style="{StaticResource BtnOperador}" Click="AgregarTexto"/>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="BtnBorrarUno"
                            Content="Borrar"
                            Style="{StaticResource BtnBorrar}"
                            Cursor="Hand"
                            Click="BorrarUno"/>

                    <Button x:Name="BtnIgual"
                            Content="="
                            Style="{StaticResource BtnIgual}"
                            Click="Calcular"/>
                </StackPanel>

                <Button x:Name="BtnLimpiarTodo"
                        Content="Limpiar Todo"
                        Style="{StaticResource BtnLimpiar}"
                        HorizontalAlignment="Left"
                        Margin="6,10,0,0"
                        Click="Limpiar"/>
            </StackPanel>
        </Border>
    </Grid>
    
</UserControl>

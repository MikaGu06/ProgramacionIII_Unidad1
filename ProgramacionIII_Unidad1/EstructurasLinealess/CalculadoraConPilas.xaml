<UserControl x:Class="ProgramacionIII_Unidad1.EstructurasLinealess.CalculadoraConPilas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProgramacionIII_Unidad1.EstructurasLinealess"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorPrimario" Color="#6A5AE0"/>
        <SolidColorBrush x:Key="Card" Color="#F8F8FC"/>
        <SolidColorBrush x:Key="BordesSuaves" Color="#D9D5F3"/>
        <SolidColorBrush x:Key="TextoOscuro" Color="#8A5A00"/>
        <SolidColorBrush x:Key="TextoClaro" Color="#6B7280"/>
        <SolidColorBrush x:Key="InputColor" Color="#EEF0F8"/>
        <SolidColorBrush x:Key="ColorAlerta" Color="#F46A6A"/>
        <SolidColorBrush x:Key="ColorNumero" Color="#FFF7DB"/>
        <SolidColorBrush x:Key="ColorOperador" Color="#EFD0B5"/>
        <SolidColorBrush x:Key="ColorIgual" Color="#D8B8E8"/>
        <SolidColorBrush x:Key="ColorLimpiar" Color="#BFD9A8"/>

        <Style x:Key="BtnCalc" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="Background" Value="{StaticResource ColorNumero}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnOperador" TargetType="Button" BasedOn="{StaticResource BtnCalc}">
            <Setter Property="Background" Value="{StaticResource ColorOperador}"/>
            <Setter  Property="Foreground" Value="#A84B00"/>
        </Style>

        <Style x:Key="BtnIgual" TargetType="Button" BasedOn="{StaticResource BtnCalc}">
            <Setter Property="Background" Value="{StaticResource ColorIgual}"/>
            <Setter Property="Width" Value="168"/>
            <Setter Property="Foreground" Value="#7A2BBE"/>
        </Style>

        <Style x:Key="BtnLimpiar" TargetType="Button" BasedOn="{StaticResource BtnCalc}">
            <Setter Property="Background" Value="{StaticResource ColorLimpiar}"/>
            <Setter Property="Width" Value="168"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#06402B"/>
        </Style>

        <Style x:Key="BtnBorrar" TargetType="Button" BasedOn="{StaticResource BtnCalc}">
            <Setter Property="Background" Value="#E7A6A6"/>
            <Setter Property="Width" Value="168"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#8b0000"/>
        </Style>

        <Style x:Key="DisplayStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordesSuaves}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoOscuro}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
            Text="Lista Simplemente Enlazada"
           FontSize="18"
           FontFamily="Segoe UI Semibold"
           Foreground="#18214D"
                   Margin="0 0 0 20"/>
        
        <Border Grid.Row="1"
            Background="{StaticResource Card}"
        BorderBrush="{StaticResource BordesSuaves}"
        BorderThickness="1.5"
        CornerRadius="16"
        Padding="20">

            <StackPanel>


                <TextBlock Text="Expresiones y operaciones básicas"
                   FontSize="14"
                   Foreground="{StaticResource TextoClaro}"
                   Margin="0,6,0,18"/>

                <TextBox x:Name="TxtPantalla"
                 Style="{StaticResource DisplayStyle}"
                 Margin="0,0,0,18"/>

                <UniformGrid Columns="4">
                    <Button x:Name="Btn7" Content="7" Style="{StaticResource BtnCalc}"/>
                    <Button x:Name="Btn8" Content="8" Style="{StaticResource BtnCalc}"/>
                    <Button x:Name="Btn9" Content="9" Style="{StaticResource BtnCalc}"/>
                    <Button x:Name="BtnDiv" Content="/" Style="{StaticResource BtnOperador}"/>

                    <Button x:Name="Btn4" Content="4" Style="{StaticResource BtnCalc}" />
                    <Button x:Name="Btn5" Content="5" Style="{StaticResource BtnCalc}" />
                    <Button x:Name="Btn6" Content="6" Style="{StaticResource BtnCalc}" />
                    <Button x:Name="BtnMul" Content="*" Style="{StaticResource BtnOperador}"/>

                    <Button x:Name="Btn1" Content="1" Style="{StaticResource BtnCalc}" />
                    <Button x:Name="Btn2" Content="2" Style="{StaticResource BtnCalc}" />
                    <Button x:Name="Btn3" Content="3" Style="{StaticResource BtnCalc}" />
                    <Button x:Name="BtnRes" Content="-" Style="{StaticResource BtnOperador}" />

                    <Button x:Name="Btn0" Content="0" Style="{StaticResource BtnCalc}" />
                    <Button x:Name="BtnParA" Content="(" Style="{StaticResource BtnOperador}"/>
                    <Button x:Name="BtnParC" Content=")" Style="{StaticResource BtnOperador}" />
                    <Button x:Name="BtnSum" Content="+" Style="{StaticResource BtnOperador}" />
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="BtnBorrarUno"
                    Content="Borrar"
                    Style="{StaticResource BtnBorrar}" Cursor="Hand"/>

                    <Button x:Name="BtnIgual"
                    Content="="
                    Style="{StaticResource BtnIgual}"/>
                </StackPanel>

                <Button x:Name="BtnLimpiarTodo"
                Content="Limpiar Todo"
                Style="{StaticResource BtnLimpiar}"
                HorizontalAlignment="Left"
                Margin="6,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    
</UserControl>
